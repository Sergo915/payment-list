# Full Corporate API root, without a trailing slash.
# Example: https://bank.example.am/OnlineBanking/CorporateApi
BANK_API_BASE_URL=

# Generate this once in Online Banking: Administration -> Access Keys.
BANK_ACCESS_KEY=

# Must uniquely identify this integration.
BANK_APPLICATION_NAME=demo-payment-list

# Corporate API language header.
BANK_LANGUAGE=en-US

# Local server settings. Keep 127.0.0.1 unless remote access is intentional.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# Exact public browser origin, without a trailing slash.
PUBLIC_ORIGIN=https://payment-list.duckdns.org

# Google Identity Services OAuth 2.0 Web Client ID.
GOOGLE_CLIENT_ID=

# Independent secret used to encrypt local Authenticator enrollments.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_SECRET=

# Only these verified Google accounts may sign in (comma-separated).
GOOGLE_ALLOWED_EMAILS=user1@example.com,user2@example.com

# Upstream request timeout in milliseconds.
BANK_REQUEST_TIMEOUT_MS=30000
BANK_MAX_RESPONSE_BYTES=20971520
